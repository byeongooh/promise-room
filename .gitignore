# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 개발 도구 설정.
# 다만 아래 둘은 팀(과 다른 컴퓨터)이 같이 써야 하므로 올린다.
#   skills/     — 이 프로젝트에서 일하는 방식. 다른 컴퓨터에서도 같아야 한다.
#   launch.json — 개발 서버 실행 설정. 비밀 값이 없다.
.claude/*
!.claude/skills/
!.claude/launch.json

# 마이그레이션 백업 (평문 비밀번호 포함 — 절대 커밋 금지)
.migration-backup/

# Applan 디자인 핸드오프 원본 (폰트·번들 포함 11MB+).
# 코드로 이미 옮겨왔고 앱 빌드에는 쓰이지 않는다. README와 PRD만 참고하려면
# 압축 안 풀고 zip 상태로 따로 보관해도 된다.
design_handoff_applan/
Senior appointment app redesign.zip