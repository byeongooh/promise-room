rules_version = '2';

// ============================================================================
// 접근 모델
// ----------------------------------------------------------------------------
// 읽기 : 그 약속의 참여자(participantIds에 내 uid가 있는 사람)만.
//        하위 컬렉션 members/ 도 같은 참여자 전원에게 열려 있다.
// 쓰기 : 클라이언트는 전면 금지. 생성·참여·탈퇴·삭제·상태변경은 모두 서버 API가
//        Admin SDK로 처리한다 (Admin SDK는 이 규칙을 우회하므로 영향 없음).
//
// 왜 쓰기를 전부 서버로 보냈나
//   1. 규칙은 필드 단위로 가릴 수 없다. 비밀번호 해시를 약속 문서에 두면
//      문서를 읽을 수 있는 사람이 해시도 같이 읽는다. 그래서 해시는
//      promises/{id}/private/ 아래에 두고 서버만 접근하게 했다.
//      그러면 비밀번호 대조(=참여)와 생성은 필연적으로 서버 일이 된다.
//   2. "참여자는 자기 자신만 목록에서 뺄 수 있다" 같은 조건은 규칙으로
//      표현하기 까다롭다. 서버에서 처리하면 그냥 코드로 검사하면 된다.
//
// 목록 조회 주의
//   규칙은 필터가 아니다. 반환되는 문서 중 하나라도 조건을 통과하지 못하면
//   쿼리 전체가 실패한다. 그래서 대시보드는 반드시
//   where("participantIds", "array-contains", 내uid) 로 조회해야 한다.
//   조건 없이 promises 컬렉션을 통째로 조회하면 실패하는데, 그게 의도다.
//
// uid 형식
//   항상 "kakao:<카카오ID>" 이다. 접두사 없는 옛 형식은 마이그레이션으로
//   모두 정리했다. lib/uid.ts 가 유일한 생성 창구다.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /promises/{promiseId} {

      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.get('participantIds', []);
      }

      function isCreator() {
        return request.auth != null
          && request.auth.uid == resource.data.get('creatorId', '');
      }

      allow get, list: if isParticipant() || isCreator();

      // 생성·수정·삭제는 서버(Admin SDK)만. 클라이언트는 어떤 경우에도 불가.
      allow create, update, delete: if false;

      // 비밀번호 해시와 시도 횟수. 참여자에게도 절대 노출하지 않는다.
      match /private/{docId} {
        allow read, write: if false;
      }

      // 참여자별 상태 — 고른 경로, 확인 안 함/가는 중/도착.
      //
      // 하위 컬렉션은 부모 문서의 조건을 물려받지 않는다. 그래서 위의
      // isParticipant()를 그대로 쓸 수 없고(여기서 resource는 member 문서다)
      // 부모 약속을 get()으로 직접 읽어 참여자인지 본다.
      //
      // 읽기는 같은 약속 참여자 전원에게 연다. "이시온은 2호선으로 온다"를
      // 서로 보는 것이 이 컬렉션의 목적이라, 본인 것만 읽게 하면 의미가 없다.
      // 쓰기는 다른 곳과 같이 서버(Admin SDK)만 — 남의 상태를 조작하거나
      // 도착하지도 않고 "도착"으로 바꾸는 것을 규칙으로 막기 어렵기 때문이다.
      match /members/{memberUid} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/promises/$(promiseId))
               .data.get('participantIds', []);

        allow write: if false;
      }
    }

    // 그 외 모든 경로는 기본 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
